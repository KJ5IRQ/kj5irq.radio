---
import type { CollectionEntry } from 'astro:content';
import StatusTag from './StatusTag.astro';
import { clusterLabels } from '../data/site';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, status, cluster, stack, started, updated, repo, links } = project.data;
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<header class="entry-header">
  <p class="kicker">{clusterLabels[cluster]} · Project</p>
  <h1 class="entry-title">{title}</h1>
  <p class="standfirst">{summary}</p>

  <dl class="facts">
    <div class="fact">
      <dt>Status</dt>
      <dd><StatusTag status={status} /></dd>
    </div>
    {started && (
      <div class="fact">
        <dt>Started</dt>
        <dd class="meta">{fmt(started)}</dd>
      </div>
    )}
    <div class="fact">
      <dt>Updated</dt>
      <dd class="meta">{fmt(updated)}</dd>
    </div>
    {stack && (
      <div class="fact">
        <dt>Stack</dt>
        <dd class="meta">{stack.join(' / ')}</dd>
      </div>
    )}
    {repo && (
      <div class="fact">
        <dt>Code</dt>
        <dd class="meta"><a href={repo} rel="noopener">Repo ↗</a></dd>
      </div>
    )}
    {links?.map((l) => (
      <div class="fact">
        <dt>More</dt>
        <dd class="meta"><a href={l.url} rel="noopener">{l.label} ↗</a></dd>
      </div>
    ))}
  </dl>
</header>

<style>
  /* Article opener, editorial: kicker, title, standfirst, then the facts as a
     hairline row rather than a sidebar. */
  .entry-header {
    padding-block: var(--space-8) var(--space-6);
  }

  .entry-title {
    font-size: var(--size-h1);
    letter-spacing: -0.02em;
    max-width: 26ch;
  }

  .standfirst {
    margin-top: var(--space-5);
    max-width: 52ch;
    font-size: var(--size-h3);
    line-height: 1.5;
    color: var(--muted);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--space-7);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule-strong);
  }

  .fact dt {
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-2);
  }

  .fact dd {
    margin: 0;
  }
</style>
