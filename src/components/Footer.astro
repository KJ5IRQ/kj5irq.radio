---
import { getCollection } from 'astro:content';
import { site } from '../data/site';
const year = new Date().getFullYear();

/* Same rule as the header: the link exists only when the shelf is not empty. */
const hasWriting = (await getCollection('writing', ({ data }) => data.publish)).length > 0;
---

<footer class="site-footer">
  <div class="wrap">
    <p class="footer-email">
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <ul class="footer-links">
      <li><a href={site.github} rel="me noopener">GitHub</a></li>
      <li><a href={site.linkedin} rel="me noopener">LinkedIn</a></li>
      <li><a href={site.qrz} rel="me noopener">QRZ</a></li>
      {hasWriting && <li><a href="/writing/">Writing</a></li>}
      <li><a href="/colophon/">Colophon</a></li>
      <li><a href="/privacy/">Privacy</a></li>
    </ul>
    <p class="meta footer-sig">
      <img class="footer-mark" src="/mark-80.png" alt="" width="40" height="40" />
      <span>73 de {site.callsign} · {site.location} · {year}</span>
    </p>
  </div>
</footer>
