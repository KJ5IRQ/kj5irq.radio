---
/* Hand-drawn rules, as SVG paths rather than borders.

   A 1px CSS border is perfectly straight, and that is exactly what makes a
   layout read as machine-made. These paths wander by two or three pixels across
   the full measure, which is the amount a pen actually drifts when someone
   rules a line by hand. One pixel of drift is invisible once the SVG is scaled
   down to a 750px column, so the amplitude here is deliberately larger than it
   looks in the source.

   `preserveAspectRatio="none"` lets one path stretch to any width. Because the
   viewBox height equals the rendered height, the vertical wobble is 1:1 and can
   be read straight off the coordinates. `vector-effect="non-scaling-stroke"`
   keeps the horizontal stretch from thinning the stroke.

   Variants: heavy (under the nameplate, and the only ink-weight rule on the
   page), hair (section rules), double (between the lead and the second tier),
   and ornament (a row of handmade marks breaking a hair rule). */
interface Props {
  variant?: 'heavy' | 'hair' | 'double' | 'ornament';
}
const { variant = 'hair' } = Astro.props;

const HAIR_PATH = 'M0 3.4 C 100 2.1 210 4.8 360 3.1 S 600 4.6 780 2.8 S 1040 4.4 1200 3.2';

const paths: Record<string, { w: number; h: number; d: string[]; weight: number }> = {
  heavy: {
    w: 1200,
    h: 14,
    weight: 3.2,
    d: ['M1 8.2 C 90 5.4 210 10.6 340 7.8 S 560 10 700 6.6 S 980 10.4 1199 7.2'],
  },
  hair: { w: 1200, h: 7, weight: 1.1, d: [HAIR_PATH] },
  double: {
    w: 1200,
    h: 10,
    weight: 1.1,
    d: [
      'M0 3 C 130 1.9 260 3.9 420 2.8 S 700 3.8 900 2.6 S 1120 3.6 1200 2.9',
      'M0 7.1 C 110 7.9 290 6.3 450 7.5 S 740 6.4 940 7.6 S 1140 6.6 1200 7.2',
    ],
  },
  ornament: { w: 160, h: 16, weight: 1.3, d: [] },
};

const { w, h, d, weight } = paths[variant];
const marks = [20, 80, 140];
---

<span class:list={['hr', `hr--${variant}`]}>
  {
    variant === 'ornament' ? (
      <>
        <svg
          class="hr-svg hr-svg--grow"
          viewBox="0 0 600 7"
          preserveAspectRatio="none"
          style="height: 7px"
          aria-hidden="true"
        >
          <path d={HAIR_PATH.replace('1200', '600')} vector-effect="non-scaling-stroke" />
        </svg>
        <svg class="hr-svg hr-svg--fixed" viewBox="0 0 160 16" width="160" height="16" aria-hidden="true">
          {marks.map((cx) => (
            <g transform={`translate(${cx - 20} 0)`}>
              <path d="M20 2 C 19.7 6.6 20.3 11.4 20 15" />
              <path d="M13.4 4.6 C 17.6 7.4 23.6 11 27.8 13.4" />
              <path d="M27.8 3.8 C 23.6 7.2 17.6 10.8 13.4 13" />
            </g>
          ))}
        </svg>
        <svg
          class="hr-svg hr-svg--grow"
          viewBox="0 0 600 7"
          preserveAspectRatio="none"
          style="height: 7px"
          aria-hidden="true"
        >
          <path d={HAIR_PATH.replace('1200', '600')} vector-effect="non-scaling-stroke" />
        </svg>
      </>
    ) : (
      <svg
        class="hr-svg"
        viewBox={`0 0 ${w} ${h}`}
        preserveAspectRatio="none"
        style={`height: ${h}px`}
        aria-hidden="true"
      >
        {d.map((p) => (
          <path d={p} vector-effect="non-scaling-stroke" stroke-width={weight} />
        ))}
      </svg>
    )
  }
</span>

<style>
  .hr {
    display: block;
    width: 100%;
  }

  .hr-svg {
    display: block;
    width: 100%;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hr--heavy {
    color: var(--ink);
  }

  .hr--hair,
  .hr--double,
  .hr--ornament {
    color: var(--rule-strong);
  }

  /* The marks are the one part of this that should be seen from across the
     room, so they carry the muted ink rather than the rule grey. */
  .hr--ornament {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    color: var(--muted);
  }

  .hr-svg--grow {
    flex: 1 1 auto;
  }

  .hr-svg--fixed {
    flex: none;
    width: 80px;
  }
</style>
