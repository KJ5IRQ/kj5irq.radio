---
import type { CollectionEntry } from 'astro:content';
import StatusTag from './StatusTag.astro';
import { clusterLabels } from '../data/site';

interface Props {
  project: CollectionEntry<'projects'>;
  /* 'lead' gives one entry the picture and more weight. The other entries stay
     quiet, and that contrast is what makes the lead read as a lead rather than
     as a picture that was dropped into a list. */
  variant?: 'standard' | 'lead';
}

const { project, variant = 'standard' } = Astro.props;
const { title, summary, whyItMatters, status, cluster, stack, updated, repo, caseStudy, image } =
  project.data;
const href = caseStudy ? `/projects/${project.id}/` : repo;
const dateLabel = updated.toISOString().slice(0, 10);
const isLead = variant === 'lead';
---

<article class:list={['entry', isLead && 'entry--lead']}>
  <div class="entry-side">
    <time class="entry-date" datetime={dateLabel}>{dateLabel}</time>
    <span class="entry-kicker">{clusterLabels[cluster]}</span>
  </div>
  <div class="entry-body">
    <h3 class="entry-title">{href ? <a href={href}>{title}</a> : title}</h3>
    {
      image && (
        <img
          class="entry-img"
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
        />
      )
    }
    <p class="entry-standfirst">{summary}</p>
    <p class="entry-note">{whyItMatters}</p>
    <p class="meta entry-meta">
      <StatusTag status={status} />
      {stack && <span>{stack.join(' / ')}</span>}
      {repo && <a href={repo} rel="noopener">Repo ↗</a>}
    </p>
  </div>
</article>

<style>
  /* The entry spine. Every kind of content renders through this, which is what
     lets one site hold projects, posts and notes without separate systems.
     Below 760px the margin column collapses above the entry. */
  .entry {
    padding-block: var(--space-6);
    border-top: 1px solid var(--rule);
  }

  .entry-side {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .entry-date {
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    font-variant-numeric: tabular-nums slashed-zero;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .entry-kicker {
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .entry-title {
    font-size: 1.5rem;
    margin-bottom: var(--space-3);
  }

  .entry-title a {
    text-decoration: none;
    color: var(--ink);
  }

  .entry-title a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .entry-standfirst {
    max-width: 58ch;
    margin-bottom: var(--space-3);
  }

  .entry-note {
    max-width: 58ch;
    color: var(--muted);
    font-style: italic;
    margin-bottom: var(--space-4);
  }

  .entry-meta {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  /* Every entry can carry a picture under its headline. The lead's runs the full
     measure; the others are inset, so the lead still reads as the lead instead
     of five equal blocks. */
  .entry-img {
    display: block;
    width: 100%;
    max-width: 460px;
    height: auto;
    border: 1px solid var(--rule);
    margin-bottom: var(--space-5);
  }

  .entry:not(.entry--lead) .entry-img {
    max-width: 300px;
  }

  /* The lead's text measure is its picture's width, so the two share one right
     edge instead of the picture hanging past the last line of the summary. */
  .entry--lead .entry-standfirst,
  .entry--lead .entry-note {
    max-width: 460px;
  }

  @media (min-width: 760px) {
    .entry {
      display: grid;
      grid-template-columns: var(--margin-col) minmax(0, 1fr);
      gap: var(--space-7);
      padding-block: var(--space-7);
    }

    .entry-side {
      flex-direction: column;
      align-items: flex-end;
      gap: var(--space-2);
      margin-bottom: 0;
      padding-top: 0.5rem;
    }

    .entry-body {
      max-width: 100%;
    }

    .entry--lead {
      padding-block: var(--space-8);
    }

    .entry--lead .entry-title {
      font-size: var(--size-h2);
      letter-spacing: -0.01em;
    }
  }
</style>
