---
import { getCollection } from 'astro:content';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

/* Writing appears in the navigation only once there is something to read. An
   empty shelf is worse than no shelf, which is the rule in
   docs/website-redesign/03_information_architecture.md section D. Add the
   first published piece and this turns itself on. */
const hasWriting = (await getCollection('writing', ({ data }) => data.publish)).length > 0;

const nav = [
  { label: 'Entries', href: '/projects/' },
  ...(hasWriting ? [{ label: 'Writing', href: '/writing/' }] : []),
  { label: 'Radio', href: '/radio/' },
  { label: 'About', href: '/about/' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href="/">{site.name}</a>
    <span class="meta callsign">{site.callsign}</span>
    <nav aria-label="Site">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule-strong);
  }

  .bar {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-5);
    flex-wrap: wrap;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--ink);
  }

  .wordmark:hover {
    color: var(--accent);
  }

  .callsign {
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  nav {
    margin-left: auto;
  }

  nav ul {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    padding-block: var(--space-2);
  }

  nav a:hover {
    color: var(--accent);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
</style>
