---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { talks } from '../data/talks';
---

<BaseLayout
  title={`Recorded nets · ${site.name}`}
  description="Recorded nets: Joshua Ford (KJ5IRQ) on the Absolute Tech Net, talking through AI for amateur radio operators."
>
  <header class="page-head">
    <p class="label">Recorded Nets</p>
    <h1>On the air</h1>
    <p class="page-dek">
      Appearances on the Absolute Tech Net, where I talked through AI for amateur radio operators.
      Title, date, and venue are the record, and a recording link is optional because it rots.
    </p>
  </header>

  <ol class="talk-list">
    {
      talks.map((talk) => (
        <li>
          <p class="meta">{talk.date}</p>
          <h2>{talk.title}</h2>
          <p>
            <a href={talk.venueUrl} rel="noopener">
              {talk.venue}
            </a>
            {talk.recordingUrl ? (
              <>
                {' · '}
                <a href={talk.recordingUrl} rel="noopener">
                  Recording
                </a>
              </>
            ) : null}
          </p>
        </li>
      ))
    }
  </ol>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-8) var(--space-7);
  }

  .page-dek {
    margin-top: var(--space-4);
    color: var(--muted);
    font-size: var(--size-h3);
    line-height: 1.4;
  }

  .talk-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-8);
    max-width: var(--measure);
  }

  .talk-list li {
    padding-block: var(--space-6);
    border-top: 1px solid var(--rule);
  }

  .talk-list h2 {
    font-size: var(--size-h3);
    margin-top: var(--space-2);
  }

  .talk-list p + p,
  .talk-list h2 + p {
    margin-top: var(--space-3);
  }
</style>
