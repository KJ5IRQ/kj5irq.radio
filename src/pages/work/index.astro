---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectEntry from '../../components/ProjectEntry.astro';
import { site } from '../../data/site';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const flagship = all.filter((p) => p.data.featured && p.data.status !== 'archived');
const rest = all.filter((p) => !p.data.featured && p.data.status !== 'archived');
const archived = all.filter((p) => p.data.status === 'archived');
---

<BaseLayout
  title={`Work · ${site.name}`}
  description="What Joshua Ford actually runs: NetSuite OneWorld by day, an AllStarLink node toolchain and local AI at home."
>
  <header class="page-head">
    <p class="label">Work</p>
    <h1>What I actually run</h1>
    <p class="page-dek">
      Ranked by how much it proves. Statuses and dates are real.
    </p>
  </header>

  <section class="cluster" aria-label="Flagship">
    <h2 class="meta cluster-heading">Flagship</h2>
    {flagship.map((project) => <ProjectEntry project={project} />)}
  </section>

  {
    rest.length > 0 && (
      <section class="cluster" aria-label="Also running">
        <h2 class="meta cluster-heading">Also running</h2>
        {rest.map((project) => (
          <ProjectEntry project={project} />
        ))}
      </section>
    )
  }

  {
    archived.length > 0 && (
      <section class="cluster" aria-label="Archive">
        <h2 class="meta cluster-heading">Archive</h2>
        {archived.map((project) => (
          <ProjectEntry project={project} />
        ))}
      </section>
    )
  }
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-8) var(--space-7);
  }

  .page-dek {
    margin-top: var(--space-4);
    color: var(--muted);
    font-size: var(--size-h3);
    line-height: 1.4;
  }

  .cluster {
    margin-bottom: var(--space-7);
  }

  .cluster-heading {
    color: var(--accent);
    letter-spacing: 0.12em;
    margin-bottom: var(--space-2);
  }
</style>
