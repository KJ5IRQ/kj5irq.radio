---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HandRule from '../components/HandRule.astro';
import StatusTag from '../components/StatusTag.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site, clusterLabels } from '../data/site';

/* The front page, broadsheet.

   A newspaper does not give every story the same space. A nameplate, then a
   three-tier index: one lead entry with its picture, a two-column tier, then a
   text-only briefs list. The hierarchy is the editorial judgment, and it is
   the thing a uniform card list cannot show.

   Placement is data, not markup: the lead is whatever `order` puts first, the
   next two fill the columns, the rest drop to briefs. To move a story up, edit
   its `order` in the content file. */
const published = (await getCollection('projects', ({ data }) => data.publish))
  .filter((p) => p.data.status !== 'archived')
  .sort(
    (a, b) => a.data.order - b.data.order || b.data.updated.valueOf() - a.data.updated.valueOf(),
  );

const [lead, ...theRest] = published;
const columns = theRest.slice(0, 2);
const briefs = theRest.slice(2);

const iso = (d: Date) => d.toISOString().slice(0, 10);
const ordinal = (i: number) => String(i + 1).padStart(2, '0');
const hrefFor = (p: (typeof published)[number]) =>
  p.data.caseStudy ? `/projects/${p.id}/` : p.data.repo;

const nameplateLine =
  'Systems operator in Texas. I run NetSuite at the director level for work, and I build the missing interfaces between business platforms, radios, and AI agents.';

/* The dateline: a live clock and the conditions at the QTH.

   The weather numbers are real and theirs, read from a public airport weather
   station at build time by scripts/fetch-weather.mjs. The station is one Josh's
   own weather engine already resolves his home to, and it is not printed here:
   no coordinates, no town, no station id. The reader sees what the weather is
   doing, not where he is.

   The reading is a snapshot, refreshed every time the site rebuilds, which the
   deploy workflow now does every 30 minutes. No observation time is printed:
   the line is what the weather is doing, kept current by rebuilding, and every
   other date on the page is a real one rather than a timestamp nobody asked
   for. */
interface Weather {
  available: boolean;
  station: string;
  observedAt: string;
  description: string | null;
  temperatureF: number;
  windMph: number | null;
  windDirection: string | null;
  humidityPct: number | null;
  fetchedAt: string;
}

/* Generated before the build and deliberately not in git. glob() returns an
   empty object when the file is absent, so a fresh clone still builds. */
const weatherFile = Object.values(
  import.meta.glob<{ default: Weather }>('../data/qth-weather.json', { eager: true }),
)[0];
const weather = weatherFile?.default?.available ? weatherFile.default : null;

const QTH_TZ = 'America/Chicago';
const fmt = (options: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat('en-US', { timeZone: QTH_TZ, ...options });

const clockTime = (date: Date) =>
  fmt({ hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }).format(date);

const buildStamp = `${fmt({
  weekday: 'short',
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(new Date())} · ${clockTime(new Date())}`;

const wind =
  weather && weather.windMph != null
    ? `${weather.windDirection ? `${weather.windDirection} ` : ''}${weather.windMph} mph`
    : null;

const weatherLine = weather
  ? [`${weather.temperatureF}°F`, weather.description, wind].filter(Boolean).join(' · ')
  : null;

/* The observation time, restored with the live path: a number that refreshes on
   its own still has to say when it was taken. */
const observedLabel = weather ? clockTime(new Date(weather.observedAt)) : null;
---

<BaseLayout chrome={false} sheet="broadsheet">
  <div class="front">
    <div class="dateline">
      <span class="dateline-item dateline-clock" id="qth-clock">{buildStamp}</span>
      <span class="dateline-item dateline-motto">Memento Mori</span>
      {/* The build-time reading stands on its own and is what a visitor without
          JavaScript, or a crawler, sees. The inline script below replaces it
          from /wx.json, which is served by our own Worker on this domain, so a
          visit still makes no request to anyone but this site. */}
      <span class="dateline-item" id="qth-wx-item" hidden={!weatherLine}>
        <span class="dateline-qth">QTH</span>
        <span id="qth-wx">{weatherLine ?? ''}</span>
        <span class="dateline-asof" id="qth-wx-asof">
          {observedLabel ? `as of ${observedLabel}` : ''}
        </span>
      </span>
    </div>
    <HandRule variant="hair" />

    <header class="nameplate">
      <div class="nameplate-text">
        <h1 class="nameplate-name">{site.name}</h1>
        <p class="nameplate-line">{nameplateLine}</p>
      </div>
      <img class="nameplate-mark" src="/mark-224.png" alt="" width="224" height="224" />
    </header>
    <HandRule variant="heavy" />

    <nav class="sections" aria-label="Sections">
      <ul>
        <li><a href="/projects/">Entries</a></li>
        <li><a href="/radio/">Radio</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/colophon/">Colophon</a></li>
      </ul>
      <ThemeToggle />
    </nav>
    <HandRule variant="hair" />

    <section class="lead" aria-labelledby="lead-title">
      <p class="kicker lead-kicker">
        <span>{clusterLabels[lead.data.cluster]}</span>
        <span class="lead-num">Entry {ordinal(0)}</span>
      </p>
      <h2 class="lead-title" id="lead-title">
        <a href={hrefFor(lead)}>{lead.data.title}</a>
      </h2>
      <p class="lead-deck">{lead.data.summary}</p>
      <div class="lead-body">
        {
          lead.data.image && (
            <figure class="lead-figure">
              <img
                src={lead.data.image.src}
                alt={lead.data.image.alt}
                width={lead.data.image.width}
                height={lead.data.image.height}
              />
            </figure>
          )
        }
        <div class="lead-text">
          <p class="lead-note">{lead.data.whyItMatters}</p>
          {/* A spec box, not a meta row. Four labelled facts behind hairlines
              is how a paper would set them, and it gives the lead's second
              column something to hold besides three lines of type. */}
          <dl class="facts">
            <dt>Status</dt>
            <dd><StatusTag status={lead.data.status} /></dd>
            {
              lead.data.stack && (
                <>
                  <dt>Stack</dt>
                  <dd>{lead.data.stack.join(' / ')}</dd>
                </>
              )
            }
            {
              lead.data.repo && (
                <>
                  <dt>Repo</dt>
                  <dd>
                    <a href={lead.data.repo} rel="noopener">
                      {lead.data.repo.replace('https://github.com/', '')} ↗
                    </a>
                  </dd>
                </>
              )
            }
            <dt>Updated</dt>
            <dd>{iso(lead.data.updated)}</dd>
          </dl>
          {
            lead.data.caseStudy ? (
              <p class="read-on">
                <a href={hrefFor(lead)}>Read the entry →</a>
              </p>
            ) : (
              lead.data.repo && (
                <p class="read-on">
                  <a href={lead.data.repo} rel="noopener">Source on GitHub ↗</a>
                </p>
              )
            )
          }
        </div>
      </div>
    </section>

    <HandRule variant="double" />

    <section class="columns" aria-label="More entries">
      {
        columns.map((p, i) => (
          <article class="column">
            <p class="kicker column-kicker">
              <span>{clusterLabels[p.data.cluster]}</span>
              <span class="column-num">Entry {ordinal(i + 1)}</span>
            </p>
            <h2 class="column-title">
              <a href={hrefFor(p)}>{p.data.title}</a>
            </h2>
            {/* The picture is the smaller part of the column and the entry's
                facts sit beside it, so a smaller picture does not leave a hole. */}
            <div class:list={['column-media', !p.data.image && 'column-media--solo']}>
              {
                p.data.image && (
                  <img
                    class="column-figure"
                    src={p.data.image.src}
                    alt={p.data.image.alt}
                    width={p.data.image.width}
                    height={p.data.image.height}
                  />
                )
              }
              <div class="column-side">
                <p class="meta">
                  <StatusTag status={p.data.status} />
                </p>
                <p class="meta column-side-line">{iso(p.data.updated)}</p>
                {
                  p.data.stack && (
                    <p class="meta column-side-line">{p.data.stack.join(' / ')}</p>
                  )
                }
              </div>
            </div>
            <p class="column-summary">{p.data.summary}</p>
            <p class="column-note">{p.data.whyItMatters}</p>
          </article>
        ))
      }
    </section>

    <HandRule variant="ornament" />

    <section class="briefs" aria-labelledby="briefs-heading">
      <h2 class="briefs-heading" id="briefs-heading">Also on the bench</h2>
      <ul class="brief-list">
        {
          briefs.map((p, i) => (
            <li class="brief">
              <time class="brief-date" datetime={iso(p.data.updated)}>{iso(p.data.updated)}</time>
              <span class="brief-kicker">{clusterLabels[p.data.cluster]}</span>
              <div class="brief-body">
                <h3 class="brief-title">
                  <a href={hrefFor(p)}>{p.data.title}</a>
                </h3>
                <p class="brief-summary">{p.data.summary}</p>
              </div>
              <span class="brief-num">{ordinal(i + 3)}</span>
            </li>
          ))
        }
      </ul>
      <p class="more">
        <a href="/projects/">Every entry →</a>
      </p>
    </section>

    <HandRule variant="hair" />

    <section class="station">
      <p class="station-line">
        <span class="station-call">{site.callsign}</span> AllStarLink node, an API and an agent that
        can key the radio. <a href="/radio/">The station →</a>
      </p>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  /* The dateline clock. It asks nobody for anything: the reader's own browser
     already knows what time it is, so this formats the current instant in Texas
     and keeps it current while the tab is open. The text rendered at build time
     is what shows if scripts are off. */
  (function () {
    var el = document.getElementById('qth-clock');
    if (!el) return;
    var at = { timeZone: 'America/Chicago' };
    var day = new Intl.DateTimeFormat(
      'en-US',
      Object.assign({ weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }, at),
    );
    var time = new Intl.DateTimeFormat(
      'en-US',
      Object.assign({ hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }, at),
    );
    function tick() {
      var now = new Date();
      el.textContent = day.format(now) + ' · ' + time.format(now);
    }
    tick();
    setInterval(tick, 20000);
  })();
</script>

<script is:inline define:vars={{ wxEndpoint: site.weatherEndpoint }}>
  /* Live weather. Fetches the Worker on our own subdomain (wx.kj5irq.radio),
     which caches the National Weather Service for five minutes, and replaces
     the build-time numbers with current ones. Same registrable domain, so a
     visit still requests nothing from a third party.
     Any failure at all leaves the build-time reading in place, which is why
     this is safe to ship before the Worker exists. */
  (function () {
    var item = document.getElementById('qth-wx-item');
    var value = document.getElementById('qth-wx');
    var asof = document.getElementById('qth-wx-asof');
    if (!item || !value || !asof) return;

    var at = { timeZone: 'America/Chicago' };
    var stamp = new Intl.DateTimeFormat(
      'en-US',
      Object.assign({ hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }, at),
    );

    fetch(wxEndpoint, { cache: 'no-store' })
      .then(function (response) {
        if (!response.ok) throw new Error('wx.json ' + response.status);
        return response.json();
      })
      .then(function (wx) {
        if (!wx || wx.available !== true || typeof wx.temperatureF !== 'number') return;
        var parts = [wx.temperatureF + '\u00b0F'];
        if (wx.description) parts.push(wx.description);
        if (wx.windMph !== null && wx.windMph !== undefined) {
          parts.push((wx.windDirection ? wx.windDirection + ' ' : '') + wx.windMph + ' mph');
        }
        value.textContent = parts.join(' \u00b7 ');
        var observed = new Date(wx.observedAt);
        if (!isNaN(observed.getTime())) asof.textContent = 'as of ' + stamp.format(observed);
        item.hidden = false;
      })
      .catch(function () {
        /* Offline, blocked, or the Worker is not deployed yet: keep what we
           built with rather than showing nothing. */
      });
  })();
</script>

<style>
  /* Front page only. The tokens are shared; nothing here changes another page.
     Metadata is deliberately smaller than the site default (11px and 10px)
     because the contrast between a 44px headline and an 11px dateline is a
     large part of what makes a page read as set rather than generated. */
  .front {
    /* The small face is Courier Prime. A Courier-class face is optically smaller
       and lighter than the utility mono this page started with, so these three
       steps sit a size up from the old numbers rather than swapping the family
       under the old sizes. */
    --mono: 'Courier Prime', 'Courier New', monospace;
    --mono-sm: 0.75rem;
    --mono-md: 0.8125rem;
    --mono-lg: 0.9375rem;
  }

  /* Kickers, mono meta rows and status tags come from shared components, so
     they need the same swap. */
  .front :global(.kicker),
  .front :global(.meta),
  .front :global(.status-tag) {
    font-family: var(--mono);
    font-size: var(--mono-md);
  }

  /* Dateline: the live clock, where this is from, and the conditions at the
     QTH. The clock is the only part of the page that changes on its own. */
  .dateline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-3);
    font-family: var(--mono);
    font-size: var(--mono-sm);
    font-variant-numeric: tabular-nums slashed-zero;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .dateline-clock {
    color: var(--ink);
  }

  /* The paper's line, in the middle of the dateline the way a motto sits under
     a nameplate. Ink rather than rule grey, and a touch more tracking than the
     items either side, so it reads as a statement instead of a third label. */
  .dateline-motto {
    color: var(--ink);
    letter-spacing: 0.18em;
  }

  .dateline-qth {
    color: var(--accent);
  }

  /* The observation time stays on one line: "PM CDT" split across two lines on
     a phone reads like a mistake. */
  .dateline-asof {
    white-space: nowrap;
  }

  .dateline-asof::before {
    content: '· ';
  }

  @media (max-width: 719px) {
    .dateline {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    /* The brief numerals are a folio detail that only works on a wide row. In
       the stacked layout they land on a line of their own under the summary,
       where they read as a stray number rather than a marker. */
    .brief-num {
      display: none;
    }
  }

  .nameplate {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-6) var(--space-5);
  }

  /* The station mark, at the size the drawing can actually be read at. It is
     decorative here: the name is already in the heading, so it carries no alt
     text and no link. */
  .nameplate-mark {
    width: clamp(88px, 12vw, 144px);
    height: auto;
    justify-self: end;
    opacity: 0.9;
  }

  :global([data-theme='dark']) .nameplate-mark {
    filter: invert(1);
    opacity: 0.82;
  }

  @media (min-width: 720px) {
    .nameplate {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: var(--space-7);
    }
  }

  .nameplate-name {
    font-size: clamp(2.4rem, 7vw, 3.75rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  .nameplate-line {
    margin-top: var(--space-4);
    max-width: 64ch;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .sections {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-3);
  }

  .sections ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
  }

  .sections a {
    font-family: var(--mono);
    font-size: var(--mono-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    /* WCAG 2.2 target size. These are the page's navigation, so the target has
       to be 24px tall, not the 16px the tracked uppercase type gives. */
    display: inline-block;
    padding-block: var(--space-2);
  }

  .sections a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .sections :global(.theme-toggle) {
    margin-left: auto;
  }

  /* Lead: the loudest thing on the page. Everything about it is larger than
     the entries below except the metadata, which stays at 11px. */
  .lead {
    padding-block: var(--space-7) var(--space-6);
  }

  .lead-kicker {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
  }

  /* The kicker row is a paragraph, so it inherits the 66-character measure cap,
     which parked "ENTRY 01" at the end of the measure instead of at the sheet's
     right margin. The number belongs on the same edge as the weather line above
     it, so the cap comes off. */
  .lead-kicker,
  .column-kicker {
    max-width: none;
  }

  .lead-num,
  .column-num,
  .brief-num {
    color: var(--faint);
  }

  .lead-title {
    margin-top: var(--space-4);
    max-width: 30ch;
    font-size: clamp(1.9rem, 4.6vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .lead-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .lead-title a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  .lead-deck {
    margin-top: var(--space-4);
    max-width: 62ch;
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }

  .lead-body {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .lead-figure img {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }

  .lead-note {
    max-width: 46ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    font-style: italic;
  }

  .facts {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    margin-top: var(--space-5);
    border-top: 1px solid var(--rule);
  }

  .facts dt,
  .facts dd {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: var(--mono-sm);
    letter-spacing: 0.08em;
  }

  .facts dt {
    padding-right: var(--space-6);
    text-transform: uppercase;
    color: var(--faint);
  }

  .facts dd {
    color: var(--ink);
  }

  .facts dd a {
    color: var(--ink);
    text-decoration: none;
  }

  .facts dd a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .read-on {
    margin-top: var(--space-5);
    font-family: var(--mono);
    font-size: var(--mono-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .read-on a {
    text-decoration: none;
  }

  /* Second tier: two columns with a visible rule between them. */
  .columns {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-6);
  }

  .column-title {
    margin-top: var(--space-3);
    font-size: 1.375rem;
    line-height: 1.15;
  }

  .column-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .column-title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.14em;
  }

  /* The picture is the smaller part of the column and the entry's facts sit
     beside it. Two reasons it is not half: halving the pictures without giving
     the rest of the width a job leaves a hole, and at half the column the
     tier-two pictures rendered WIDER than the lead's, which inverted the
     hierarchy the whole page is built on. At 0.8/1.2 the lead picture is the
     largest on the page, as it should be. */
  .column-media {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--space-4);
    align-items: start;
    margin-top: var(--space-4);
  }

  .column-media--solo {
    grid-template-columns: minmax(0, 1fr);
  }

  .column-figure {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--rule);
  }

  .column-side {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-left: var(--space-4);
    border-left: 1px solid var(--rule);
  }

  .column-side .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .column-side-line {
    line-height: 1.45;
  }

  .column-summary {
    margin-top: var(--space-5);
    font-size: 1.0625rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .column-note {
    margin-top: var(--space-3);
    font-size: 1rem;
    line-height: 1.55;
    font-style: italic;
    color: var(--muted);
  }

  /* Third tier: briefs, text only, date in the margin. */
  .briefs {
    padding-block: var(--space-6) var(--space-5);
  }

  .briefs-heading {
    font-family: var(--mono);
    font-size: var(--mono-sm);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--rule-strong);
  }

  .brief-list {
    list-style: none;
    padding: 0;
  }

  .brief {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--rule);
  }

  .brief-date,
  .brief-kicker,
  .brief-num {
    font-family: var(--mono);
    font-size: var(--mono-sm);
    font-variant-numeric: tabular-nums slashed-zero;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .brief-date,
  .brief-num {
    color: var(--faint);
  }

  .brief-kicker {
    color: var(--accent);
  }

  .brief-body {
    grid-column: 1 / -1;
  }

  .brief-title {
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .brief-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .brief-title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.14em;
  }

