---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import { site } from '../data/site';
import now from '../data/now.json';
import headshot from '../assets/headshot.jpg';

const all = await getCollection('projects');
const flagship = all.find((p) => p.id === 'allstar-toolchain');
const second = all.find((p) => p.id === 'hermes-kb');
---

<BaseLayout>
  <section class="hero">
    <p class="kicker">{site.callsign} · {site.location}</p>
    <h1>I run systems. Some of them talk back.</h1>
    <p class="dek">
      I run NetSuite for a multi-company rural ISP. At home I put real interfaces on radios and
      agents, and I operate all of it.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href={`mailto:${site.email}`}>Email me</a>
      <a class="button" href="/work/">See the work</a>
    </div>
    <p class="meta now-line">
      <a href="/now/">Now</a>
      · {now.updated} · {now.line}
    </p>
  </section>

  {
    flagship && (
      <section class="home-section" aria-labelledby="flagship-heading">
        <p class="label" id="flagship-heading">Proof</p>
        <ProjectEntry project={flagship} />
        {second && <ProjectEntry project={second} />}
      </section>
    )
  }

  <section class="home-section operator" aria-labelledby="operator-heading">
    <p class="label" id="operator-heading">The operator</p>
    <div class="operator-grid">
      <div>
        <p>
          I started in warehouse operations and ended up running the ERP. The habit stuck: learn
          the system end to end, then automate the boring parts.
        </p>
        <p>Based in Texas. Usually tinkering with something.</p>
        <p class="more-link"><a href="/about/">More about me →</a></p>
      </div>
      <Image
        src={headshot}
        alt="Joshua Ford"
        width={320}
        widths={[320, 640]}
        sizes="(max-width: 700px) 40vw, 220px"
        class="operator-photo"
      />
    </div>
  </section>

  <section class="home-section station-strip" aria-labelledby="station-heading">
    <p class="label" id="station-heading">The station</p>
    <p>
      <span class="meta callsign-inline">{site.callsign}</span> is my amateur radio callsign. The
      node is also a Linux box. That overlap is <a href="/radio/">the radio page</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-9) var(--space-8);
    border-bottom: 1px solid var(--rule);
  }

  .hero .kicker {
    margin-bottom: var(--space-6);
  }

  .hero h1 {
    font-size: var(--size-display);
    max-width: 16ch;
  }

  .dek {
    margin-top: var(--space-6);
    font-size: var(--size-h3);
    line-height: 1.5;
    color: var(--ink);
    max-width: 48ch;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-7);
  }

  .now-line {
    margin-top: var(--space-6);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .home-section {
    padding-block: var(--space-8);
  }

  .more-link {
    margin-top: var(--space-5);
  }

  .operator-grid {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) auto;
    gap: var(--space-7);
    align-items: start;
  }

  .operator-grid p + p {
    margin-top: var(--space-4);
  }

  .operator-photo {
    border: 1px solid var(--rule);
    width: 220px;
    height: auto;
  }

  .station-strip {
    border-top: 1px solid var(--rule);
  }

  .callsign-inline {
    color: var(--accent);
    font-size: var(--size-body);
  }

  @media (max-width: 700px) {
    .operator-grid {
      grid-template-columns: 1fr;
    }

    .operator-photo {
      width: 160px;
    }
  }
</style>
