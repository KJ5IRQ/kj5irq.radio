---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import { site } from '../data/site';

/* The front door. A masthead, then the work itself, newest first. No hero
   animation, no featured-card grid: a contents page is the better routing
   device for employers, friends and strangers alike. */
const entries = (await getCollection('projects', ({ data }) => data.publish))
  .filter((p) => p.data.status !== 'archived')
  // `order` is explicit editorial placement; everything left at the default
  // falls back to most recently updated first.
  .sort(
    (a, b) => a.data.order - b.data.order || b.data.updated.valueOf() - a.data.updated.valueOf(),
  );

const buildDate = new Date().toISOString().slice(0, 10);
---

<BaseLayout>
  <section class="masthead">
    <h1 class="masthead-name">{site.name}</h1>
    <p class="masthead-line">
      Systems operator in Texas. I run an ERP platform for work, and I build the missing
      interfaces between business platforms, radios, and AI agents.
    </p>
    <p class="meta masthead-meta">TX · {site.callsign} · Updated {buildDate}</p>
    <p class="masthead-actions">
      <a class="button button-primary" href={`mailto:${site.email}`}>Email me</a>
      <a class="button" href="/about/">About</a>
    </p>
  </section>

  <section aria-labelledby="entries-heading">
    <h2 class="section-heading" id="entries-heading">Entries</h2>
    {entries.map((project) => (
      <ProjectEntry project={project} />
    ))}
    <p class="more-link"><a href="/projects/">All entries →</a></p>
  </section>
</BaseLayout>

<style>
  .masthead {
    padding-block: var(--space-9) var(--space-8);
    border-bottom: 1px solid var(--rule-strong);
    margin-bottom: var(--space-7);
  }

  .masthead-name {
    font-size: var(--size-masthead);
    letter-spacing: -0.02em;
  }

  .masthead-line {
    margin-top: var(--space-5);
    max-width: 58ch;
    font-size: var(--size-h3);
    line-height: 1.5;
    color: var(--ink);
  }

  .masthead-meta {
    margin-top: var(--space-5);
  }

  .masthead-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-6);
    max-width: none;
  }

  .more-link {
    margin-top: var(--space-6);
  }
</style>
