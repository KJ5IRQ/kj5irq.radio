---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import { site } from '../data/site';
import headshot from '../assets/headshot.jpg';

const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured && p.data.status !== 'archived')
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);
---

<BaseLayout>
  <section class="masthead">
    <div class="intro">
      <p class="kicker">{site.callsign} · {site.location}</p>
      <h1>I run systems. Some of them talk back.</h1>
      <p class="dek">
        Director of NetSuite Administration. I run a OneWorld environment I helped select, stood
        up, and still operate. At home I put the same kind of interface on radios and agents.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href={`mailto:${site.email}`}>Email me</a>
        <a class="button" href="/work/">See the work</a>
      </div>
    </div>
    {
      featured.length > 0 && (
        <div class="proof" aria-labelledby="flagship-heading">
          <p class="label" id="flagship-heading">
            Proof
          </p>
          {featured.map((project) => (
            <ProjectEntry project={project} />
          ))}
        </div>
      )
    }
  </section>

  <section class="home-section operator" aria-labelledby="operator-heading">
    <p class="label" id="operator-heading">The operator</p>
    <div class="operator-grid">
      <div>
        <p>
          I started on a warehouse floor and kept following the system upstream until I owned the
          ERP. Same habit at home: learn it end to end, then automate the boring parts.
        </p>
        <p>
          Based in Texas. Usually tinkering with something. I explain the AI side of it on
          <a href="/talks/">Absolute Tech</a>.
        </p>
        <p class="more-link"><a href="/about/">More about me →</a></p>
      </div>
      <Image
        src={headshot}
        alt="Joshua Ford"
        width={320}
        widths={[320, 640]}
        sizes="(max-width: 700px) 40vw, 220px"
        class="operator-photo"
      />
    </div>
  </section>

  <section class="home-section station-strip" aria-labelledby="station-heading">
    <p class="label" id="station-heading">The station</p>
    <p>
      <span class="meta callsign-inline">{site.callsign}</span> is my amateur radio callsign. The
      node is also a Linux box. That overlap is <a href="/radio/">the radio page</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .masthead {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--space-6) var(--space-7);
    align-items: start;
    padding-block: var(--space-5) var(--space-6);
    border-bottom: 1px solid var(--rule);
  }

  .intro .kicker {
    margin-bottom: var(--space-3);
  }

  .masthead h1 {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    max-width: 16ch;
    line-height: 1.15;
  }

  .dek {
    margin-top: var(--space-3);
    font-size: var(--size-body);
    line-height: 1.45;
    max-width: 42ch;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-5);
  }

  .proof .label {
    margin-bottom: var(--space-2);
  }

  .proof :global(.entry) {
    padding-block: var(--space-4);
  }

  .proof :global(.entry:first-of-type) {
    border-top: 0;
    padding-top: 0;
  }

  .home-section {
    padding-block: var(--space-7);
  }

  .more-link {
    margin-top: var(--space-5);
  }

  .operator-grid {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) auto;
    gap: var(--space-7);
    align-items: start;
  }

  .operator-grid p + p {
    margin-top: var(--space-4);
  }

  .operator-photo {
    border: 1px solid var(--rule);
    width: 220px;
    height: auto;
  }

  .station-strip {
    border-top: 1px solid var(--rule);
  }

  .callsign-inline {
    color: var(--ink);
    font-size: var(--size-body);
  }

  @media (max-width: 800px) {
    .masthead {
      grid-template-columns: 1fr;
      padding-block: var(--space-5);
      gap: var(--space-5);
    }
  }

  @media (max-width: 700px) {
    .operator-grid {
      grid-template-columns: 1fr;
    }

    .operator-photo {
      width: 160px;
    }
  }
</style>
