---
import '@fontsource-variable/source-serif-4';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
/* Typewriter candidates for the small-face slot, being tried on the front page.
   Only the face in use downloads: a @font-face declared and never matched costs
   nothing at read time, so keeping the candidates here is free until one is
   chosen and the others are removed. */
import '@fontsource/courier-prime/latin-400.css';
import '@fontsource/cutive-mono/latin-400.css';
import '@fontsource/special-elite/latin-400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /* The front page carries its own nameplate, which includes the section strip
     and the theme toggle. Rendering the site header there as well puts the
     name on the page twice within 100px, so the front page opts out. Every
     other page keeps the header. */
  chrome?: boolean;
  /* The front page is a sheet rather than a page: it gets the wider measure and
     does not need a prose page's breathing room above the footer. */
  sheet?: 'default' | 'broadsheet';
}

const {
  title = site.defaultTitle,
  description = site.defaultDescription,
  noindex = false,
  chrome = true,
  sheet = 'default',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;

const personJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.callsign,
  url: site.url,
  sameAs: [site.github, site.linkedin, site.qrz],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Light is the default. Dark is only applied when the visitor has chosen it.
      (function () {
        try {
          if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.dataset.theme = 'dark';
          }
        } catch (e) {}
      })();
    </script>
    <meta name="theme-color" content="#f9f7f4" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.callsign}`} />
    <meta property="og:site_name" content={site.defaultTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={personJsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {chrome && <Header />}
    <main id="main" class:list={['wrap', sheet === 'broadsheet' && 'wrap--broadsheet']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
